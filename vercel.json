{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "outputDirectory": "frontend",
  "env": {
    "NODE_ENV": "production"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    },
    {
      "src": "/",
      "dest": "/frontend/dashboard.html"
    }
  ]
}