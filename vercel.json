{
  "version": 2,
  "buildCommand": "cd backend && npm install",
  "public": true,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/backend/server.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"]
    },
    {
      "src": "/js/(.*)",
      "dest": "/FE-Stitch/js/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/FE-Stitch/css/$1"
    },
    {
      "src": "/(.*\\.html)",
      "dest": "/FE-Stitch/$1"
    },
    {
      "src": "/",
      "dest": "/FE-Stitch/dashboard.html"
    }
  ]
}