# Environment Variables Template untuk Backend

# Copy file ini menjadi .env dan isi dengan values Anda sendiri

# Server Configuration
PORT=3001
NODE_ENV=development

# Supabase Configuration
# Dapatkan dari: https://app.supabase.com → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Contoh (jangan pakai value ini):
# SUPABASE_URL=https://abcdefg123.supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhhYmdkZnZ...
# SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhhYmdkZnZ...
